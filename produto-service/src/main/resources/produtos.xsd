<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://fatec.edu.br/delivery/produto"
    xmlns:tns="http://fatec.edu.br/delivery/produto"
    elementFormDefault="qualified">

    <!-- REQUISIÇÃO -->
    <xs:element name="consultarProdutoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="codigoProduto" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- RESPOSTA -->
    <xs:element name="consultarProdutoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="codigoProduto" type="xs:string"/>
                <xs:element name="nomeProduto" type="xs:string"/>
                <xs:element name="descricao" type="xs:string"/>
                <xs:element name="marca" type="xs:string"/>
                <xs:element name="quantidadeEstoque" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>